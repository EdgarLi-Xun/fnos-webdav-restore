#!/bin/bash
set -e

PIDFILE="${TRIM_PKGVAR}/webdavfix.pid"
LOGFILE="${TRIM_PKGVAR}/webdavfix.log"
CONF="${TRIM_PKGETC}/config.env"
SOCKET="${TRIM_APPDEST}/app.sock"
PREFIX="/app/webdavfix"

load_conf() {
  if [ -f "$CONF" ]; then
    # shellcheck disable=SC1090
    . "$CONF"
  fi
}

is_running() {
  [ -f "$PIDFILE" ] || return 1
  kill -0 "$(cat "$PIDFILE")" 2>/dev/null
}

start_app() {
  mkdir -p "$TRIM_PKGVAR" "$TRIM_PKGETC"
  if [ ! -f "$CONF" ]; then
    printf 'WEBDAVFIX_DAV_USER=\nWEBDAVFIX_DAV_PASSWORD=\nWEBDAVFIX_NEED_SHARES=\n' > "$CONF"
    chmod 600 "$CONF"
  fi
  load_conf
  export WEBDAVFIX_ETC="$TRIM_PKGETC"
  export WEBDAVFIX_PREFIX="$PREFIX"
  export WEBDAVFIX_SOCKET="$SOCKET"
  rm -f "$SOCKET"
  nohup python3 "$TRIM_APPDEST/bin/server.py" >> "$LOGFILE" 2>&1 &
  echo $! > "$PIDFILE"
  if python3 - "$SOCKET" <<'PY'
import os
import socket
import sys
import time

path = sys.argv[1]
for _ in range(30):
    if os.path.exists(path):
        sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        sock.settimeout(1)
        try:
            sock.connect(path)
            sock.close()
            sys.exit(0)
        except Exception:
            pass
    time.sleep(0.3)
sys.exit(1)
PY
  then
    if is_running; then
      return 0
    fi
  fi
  echo "webdavfix failed to listen on ${SOCKET}" > "$TRIM_TEMP_LOGFILE"
  return 1
}

stop_app() {
  if is_running; then
    kill "$(cat "$PIDFILE")" 2>/dev/null || true
    sleep 1
    if is_running; then
      kill -9 "$(cat "$PIDFILE")" 2>/dev/null || true
    fi
  fi
  rm -f "$PIDFILE" "$SOCKET"
  return 0
}

case "$1" in
  start)
    if is_running; then
      exit 0
    fi
    start_app
    ;;
  stop)
    stop_app
    ;;
  status)
    if is_running; then
      echo "webdavfix is running"
      exit 0
    fi
    echo "webdavfix is not running"
    exit 3
    ;;
  *)
    exit 1
    ;;
esac
